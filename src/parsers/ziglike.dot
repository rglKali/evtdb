digraph G {
    splines = "FALSE";
    
    subgraph File {
        f_file [style = filled;label = "file";];
        f_type [label = "type";];
        f_ident [label = "ident";];
        f_assignment [label = "=";];
        f_value [label = "value";];
        f_assignment [label = "=";];
        f_terminator [label = ";";];

        f_file -> f_type;
        f_type -> f_ident;
        f_ident -> f_assignment;
        f_assignment -> f_value;
        f_value -> f_terminator;
        f_terminator -> f_type;
    }
    
    subgraph Value {
        v_value [label = "value";style = filled;];
        v_struct [label = "struct";];
        v_union [label = "union";];
        v_enum [label = "enum";];
        v_array [label = "array";style = filled;];
        v_ident [label = "ident";];

        vsu_lbrace [label = "{";];
        vsu_ident [label = "ident";];
        vsu_colon [label = ":";];
        vsu_value [label = "value";];
        vsu_comma [label = ",";];
        vsu_rbrace [label = "}";];

        e_lbrace [label = "{";];
        e_ident [label = "ident";];
        e_comma [label = ",";];
        e_rbrace [label = "}";];

        va_lbrack [label = "[";];
        va_rbrack [label = "]";];
        va_length [label = "length";];
        va_value [label = "value";];

        v_value -> v_struct;
        v_value -> v_union;
        v_value -> v_enum;
        v_value -> v_array;

        v_struct -> vsu_lbrace;
        v_union -> vsu_lbrace;
        vsu_lbrace -> vsu_ident;
        vsu_ident -> vsu_colon;
        vsu_colon -> vsu_value;
        vsu_value -> vsu_comma;
        vsu_comma -> vsu_ident;
        vsu_value -> vsu_rbrace;

        v_enum -> e_lbrace;
        e_lbrace -> e_ident;
        e_ident -> e_comma;
        e_comma -> e_ident;
        e_ident -> e_rbrace;

        v_array -> va_lbrack;
        va_lbrack -> va_length;
        va_length -> va_rbrack;
        va_rbrack -> va_value;

        v_value -> v_ident;
    }
}